{
  // Depuração no Chrome. Antes, suba o servidor com `npm run dev` (Vite, porta 5173).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir o painel no Chrome (npm run dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Anexar ao Chrome (porta 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ]
}

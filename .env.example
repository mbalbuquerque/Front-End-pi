# Copie para .env.local e ajuste. Sem este arquivo, o painel usa a API publicada.
# URL base da API do ColdTrack (Azure Function), sem barra no final.
VITE_API_URL=https://func-coldtrack-7319.azurewebsites.net/api

# Suíte e2e real (npm run test:e2e:real): contas da empresa de demonstração.
# Copie para .env.local (fora do git) e preencha. NUNCA commite as senhas.
# Sem estas variáveis, os testes que precisam de login são pulados.
COLDTRACK_GESTOR_EMAIL=
COLDTRACK_GESTOR_SENHA=
COLDTRACK_OPERADOR_EMAIL=
COLDTRACK_OPERADOR_SENHA=
# Opcionais: site e API testados (padrão: os publicados no Azure).
COLDTRACK_SITE_URL=
COLDTRACK_API_URL=

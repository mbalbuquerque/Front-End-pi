{
  "name": "coldtrack-control",
  "private": true,
  "version": "2.0.0",
  "description": "ColdTrack Control: painel web (React + Vite) do projeto ColdTrack Edge, monitoramento IoT da cadeia fria.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:real": "playwright test --config playwright.real.config.js",
    "test:e2e:real:report": "playwright show-report playwright-report-real",
    "test:e2e:real:limpar": "node coldtrack-qa/real/limpar-qa.js",
    "lint": "eslint . --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbalbuquerque/Front-End-pi.git"
  },
  "bugs": {
    "url": "https://github.com/mbalbuquerque/Front-End-pi/issues"
  },
  "homepage": "https://github.com/mbalbuquerque/Front-End-pi#readme",
  "license": "ISC",
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss-prefix-selector": "^2.2.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
